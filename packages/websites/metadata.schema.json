{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Presence Metadata",
  "description": "Schema for presence metadata.json files",
  "type": "object",
  "required": [
    "name",
    "author",
    "description",
    "url",
    "color",
    "category",
    "assets"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "description": "Auto-generated from folder name — do not set manually"
    },
    "name": {
      "type": "string",
      "description": "Display name of the service/platform"
    },
    "author": {
      "type": "object",
      "description": "Main author of the presence",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "github": {
          "type": "string",
          "description": "GitHub username for avatar auto-resolution"
        }
      }
    },
    "contributors": {
      "type": "array",
      "description": "Additional contributors (not including author)",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "github": {
            "type": "string",
            "description": "GitHub username for avatar auto-resolution"
          }
        }
      }
    },
    "description": {
      "type": "object",
      "description": "Short descriptions keyed by locale (e.g. en-US, fr-FR). Must include at least en-US.",
      "minProperties": 1,
      "additionalProperties": { "type": "string" },
      "propertyNames": {
        "pattern": "^[a-z]{2}-[A-Z]{2}$"
      }
    },
    "longDescription": {
      "type": "object",
      "description": "Detailed descriptions keyed by locale",
      "additionalProperties": { "type": "string" },
      "propertyNames": {
        "pattern": "^[a-z]{2}-[A-Z]{2}$"
      }
    },
    "url": {
      "type": "array",
      "description": "List of URL patterns this presence matches",
      "items": { "type": "string" }
    },
    "regExp": {
      "type": "string",
      "description": "RegExp pattern to match URLs beyond simple domain matching"
    },
    "world": {
      "type": "string",
      "description": "Execution context. 'main' runs the presence in the page world (needed for page globals or same-origin authenticated fetch); defaults to isolated.",
      "enum": ["main", "isolated"]
    },
    "runAt": {
      "type": "string",
      "description": "When the presence script is injected. Defaults to document_idle.",
      "enum": ["document_start", "document_end", "document_idle"]
    },
    "color": {
      "type": "string",
      "description": "Brand color in hex format (e.g. #FF0033)",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "category": {
      "type": "string",
      "description": "Category of the platform",
      "enum": ["streaming", "music", "video", "social", "gaming", "tools", "ai", "learning", "creator", "other"]
    },
    "features": {
      "type": "object",
      "description": "Feature lists keyed by locale (1-10 items per locale)",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": { "type": "string" }
      },
      "propertyNames": {
        "pattern": "^[a-z]{2}-[A-Z]{2}$"
      }
    },
    "assets": {
      "type": "object",
      "description": "Asset filenames for the marketplace",
      "required": ["logo", "icon", "thumbnail"],
      "properties": {
        "logo": {
          "type": "string",
          "description": "Logo image (e.g. logo.png)"
        },
        "icon": {
          "type": "string",
          "description": "Transparent icon for colored backgrounds (e.g. icon.png)"
        },
        "thumbnail": {
          "type": "string",
          "description": "Thumbnail image for the detail page (e.g. thumbnail.jpg)"
        }
      }
    }
  }
}
