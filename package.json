{
  "name": "presence",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "version": "1.0.0",
  "description": "Presence monorepo",
  "scripts": {
    "dev:api": "pnpm --filter @nowly/api dev",
    "dev:web": "pnpm --filter @nowly/web dev",
    "build:websites": "pnpm --filter @nowly/websites build",
    "prisma:generate": "pnpm --filter @nowly/api prisma:generate",
    "start:api": "pnpm --filter @nowly/api start",
    "typecheck:api": "pnpm --filter @nowly/api typecheck",
    "presence": "pnpm --filter @nowly/websites cli",
    "presence:build": "pnpm --filter @nowly/websites cli build",
    "presence:clean": "node -e \"fs.rmSync('packages/websites/dist/presences',{recursive:true,force:true})\"",
    "presence:rebuild": "pnpm presence:clean && pnpm presence:build",
    "build:extension": "pnpm --filter @nowly/extension build",
    "build:extension:dev": "pnpm --filter @nowly/extension build:dev",
    "admin:push": "pnpm --filter @nowly/internal-cli cli push",
    "admin": "pnpm --filter @nowly/internal-cli cli",
    "admin:r2-sync": "pnpm --filter @nowly/internal-cli r2:sync",
    "admin:host-publish": "pnpm --filter @nowly/internal-cli host:publish",
    "build:macos": "cd apps/native && bash scripts/macos-release.sh"
  }
}
