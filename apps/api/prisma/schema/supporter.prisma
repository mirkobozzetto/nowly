model SupporterPass {
  id          String    @id
  codeHash    String    @unique @map("code_hash")
  provider    String    @default("manual")
  providerRef String?   @map("provider_ref")
  status      String    @default("active")
  maxDevices  Int       @default(5) @map("max_devices")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  devices SupporterDevice[]
  events  DonationEvent[]

  @@index([status])
  @@map("supporter_passes")
}

model SupporterDevice {
  passId      String   @map("pass_id")
  deviceId    String   @map("device_id")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  pass SupporterPass @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@id([passId, deviceId])
  @@index([deviceId])
  @@map("supporter_devices")
}

model DonationEvent {
  id              String   @id
  provider        String
  providerEventId String   @map("provider_event_id")
  passId          String?  @map("pass_id")
  amount          String?
  currency        String?
  donorEmailHash  String?  @map("donor_email_hash")
  donorName       String?  @map("donor_name")
  donorLogin      String?  @map("donor_login")
  payload         Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pass SupporterPass? @relation(fields: [passId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([passId])
  @@map("donation_events")
}
