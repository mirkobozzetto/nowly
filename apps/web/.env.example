# API secret key for protected endpoints
API_SECRET_KEY=

# Private key (DER, base64url-encoded) for signing presence releases
PRESENCE_SIGNING_PRIVATE_KEY=

# Internal API server URL (defaults to https://api.nowly.me)
PRESENCE_API_URL=https://api.nowly.me

# Client-side API base URL (defaults to https://api.nowly.me)
NEXT_PUBLIC_API_BASE_URL=https://api.nowly.me

# Chrome Web Store extension ID (defaults to prod: kmnlnfldimgneaopdihplkebobckcjpf)
# Set to your dev extension ID for local development
NEXT_PUBLIC_EXTENSION_ID=

# Google AdSense public config.
# Set NEXT_PUBLIC_ADSENSE_ENABLED=true locally or in Vercel to enable ads and the adblock notice.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_LANDING_SLOT=
NEXT_PUBLIC_ADSENSE_LIBRARY_SLOT=
